{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"react",
		"typescript",
		"oxc"
	],
	"rules": {
		"react/rules-of-hooks": "error",
		"react/only-export-components": [
			"warn",
			{
				"allowConstantExport": true,
				// Fast-refresh only complains about non-component exports living next to components
				// These names come from the shadcn catalogue (variant factories, hooks, the toast manager) and are HMR-safe
				"allowExportNames": [
					"badgeVariants",
					"buttonVariants",
					"toggleVariants",
					"navigationMenuTriggerStyle",
					"useComboboxAnchor",
					"createToastManager",
					"toast",
					"useToastManager",
					"useTheme"
				]
			}
		]
	}
}
